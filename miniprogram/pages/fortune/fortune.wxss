.card-tag {
  font-size: 26rpx;
  color: #e8c477;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.draw-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #e8c477;
  text-align: center;
  letter-spacing: 4rpx;
}

.draw-text {
  font-size: 26rpx;
  color: #d8c9ad;
  line-height: 1.8;
  margin: 18rpx 0;
  text-align: center;
}

.draw-meta {
  font-size: 22rpx;
  color: #9c8c74;
  text-align: center;
}

.bars {
  margin: 6rpx 0 14rpx;
}

.bar {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #cbb893;
  margin-bottom: 14rpx;
}

.bar > text:first-child {
  width: 80rpx;
}

.bar > text:last-child {
  width: 56rpx;
  text-align: right;
  color: #e8c477;
}

.track {
  flex: 1;
  height: 14rpx;
  background: #1a140d;
  border-radius: 10rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.fill {
  height: 100%;
  background: linear-gradient(90deg, #c79a45, #e8c477);
  border-radius: 10rpx;
}

.luck-text {
  font-size: 25rpx;
  color: #d8c9ad;
  line-height: 1.7;
}
