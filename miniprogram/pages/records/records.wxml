<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="switchTab">历史记录</view>
    <view class="tab {{tab === 'favorites' ? 'active' : ''}}" data-tab="favorites" bindtap="switchTab">我的收藏</view>
  </view>

  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="member-bar" bindtap="goMember">
    <text>会员状态：{{member.tier === 'vip' ? '💎 VIP' : '🆓 免费'}}</text>
    <text class="arrow">›</text>
  </view>

  <block wx:if="{{tab === 'history'}}">
    <view class="empty" wx:if="{{history.length === 0}}">
      <view>还没有测算记录</view>
      <view class="link" bindtap="goCalc">去首页试试吧 ›</view>
    </view>
    <view class="item" wx:for="{{history}}" wx:key="id">
      <view class="item-top">
        <text class="item-title">{{item.title}}</text>
        <text class="item-del" data-id="{{item.id}}" bindtap="delHistory">删除</text>
      </view>
      <view class="item-summary">{{item.summary}}</view>
      <view class="item-time">{{item.createdAt}}</view>
    </view>
  </block>

  <block wx:if="{{tab === 'favorites'}}">
    <view class="empty" wx:if="{{favorites.length === 0}}">
      <view>还没有收藏</view>
      <view class="link" bindtap="goCalc">去测算并收藏 ›</view>
    </view>
    <view class="item" wx:for="{{favorites}}" wx:key="id">
      <view class="item-top">
        <text class="item-title">{{item.title}}</text>
        <text class="item-del" data-id="{{item.id}}" bindtap="delFavorite">删除</text>
      </view>
      <view class="item-summary">{{item.summary}}</view>
      <view class="item-time">{{item.createdAt}}</view>
    </view>
  </block>

  <view class="entries">
    <view class="entry" bindtap="goSettings">服务设置（后端地址）</view>
    <view class="entry" bindtap="goAbout">查看免责声明</view>
  </view>
</view>
