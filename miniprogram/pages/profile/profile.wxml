<view class="page tab-page">
  <view class="hero-sm">我的</view>

  <!-- 用户卡 -->
  <view class="card user">
    <view class="avatar">{{avatarText}}</view>
    <view class="uinfo">
      <view class="uname">{{nickname}}</view>
      <view class="utier">{{memberText}}</view>
    </view>
  </view>

  <!-- 会员入口（二级） -->
  <view class="entry vip-entry" bindtap="goMember">
    <text>会员中心</text>
    <text class="arrow">›</text>
  </view>

  <view class="group">
    <view class="entry" bindtap="goRecords" data-tab="history">
      <text>历史记录</text>
      <text class="arrow">›</text>
    </view>
    <view class="entry" bindtap="goRecords" data-tab="favorites">
      <text>我的收藏</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="group">
    <view class="entry" bindtap="goPage" data-url="/pages/settings/settings">
      <text>服务设置</text>
      <text class="arrow">›</text>
    </view>
    <view class="entry" bindtap="goPage" data-url="/pages/about/about">
      <text>免责声明</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="disclaimer">命理测算 · 趣味参考，仅供娱乐</view>
</view>
