<view class="member">
  <view class="status card">
    <view class="status-title">会员状态</view>
    <block wx:if="{{member.tier === 'vip'}}">
      <view class="vip">💎 你已是 VIP 会员</view>
      <view class="expire" wx:if="{{member.expireAt}}">有效期至：{{member.expireAt}}</view>
      <view class="desc">已解锁：全部 13 个体系的「会员专享·深度延展」解读。</view>
    </block>
    <block wx:else>
      <view class="free">🆓 当前为免费用户</view>
      <view class="desc">开通会员可解锁每个测算的「深度延展」专属解读。</view>
    </block>
  </view>

  <view class="plans" wx:if="{{member.tier !== 'vip'}}">
    <view class="plan card" wx:for="{{plans}}" wx:key="key">
      <view class="plan-label">{{item.label}}</view>
      <view class="plan-price">{{item.price}}</view>
      <button class="primary" data-plan="{{item.key}}" bindtap="upgrade">开通</button>
    </view>
  </view>
  <view class="plan card" wx:else>
    <view class="plan-label">会员已开通</view>
    <view class="plan-price">感谢你的支持 ✦</view>
  </view>

  <view class="note">本会员功能为<text class="strong">本地演示</text>，数据保存在本机，<text class="strong">未接入任何真实支付</text>。正式上线时替换为微信支付 / 苹果内购即可。</view>

  <view class="toast" wx:if="{{toast}}">{{toast}}</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>
